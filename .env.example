# ===================================================================
# SMART BANKING MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# Instructions:
# 1. Copy this file to '.env' in your local development environment.
# 2. Update the credentials below to match your local MySQL configuration.
# 3. Never commit the actual '.env' file containing secrets to version control.
# ===================================================================

# Application Server Port
SERVER_PORT=8080

# Database Configuration (MySQL 8.x)
DB_URL=jdbc:mysql://localhost:3306/smart_banking_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_root_password_here

# JWT Security Configuration
# JWT_SECRET: 256-bit or 512-bit hex/base64 encoded HMAC-SHA secret key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# JWT_EXPIRATION: Token lifespan in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION=86400000

# Default Seed Administrator Credentials (Initialized on first startup)
ADMIN_EMAIL=admin@smartbank.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=System Administrator
ADMIN_PHONE=9999999999
ADMIN_ADDRESS=Headquarters, Smart Bank Tower, Mumbai
