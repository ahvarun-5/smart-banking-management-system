            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Customer@123\",\n  \"newPassword\": \"NewSecret@789\",\n  \"confirmNewPassword\": \"NewSecret@789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "change-password"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Admin Management",
